# ==========================================
# 🛑 ACTION REQUIRED: UPDATE THESE VARIABLES
# ==========================================

# 1. Database Connection (Required)
# Update this to your actual PostgreSQL database URL.
# 💡 PRO TIP: We highly recommend using a free cloud database like Neon DB or Supabase! 
# It is much easier than running Postgres locally. Just paste their connection string here.
# (Note: Local Postgres will NOT run with Docker unless you change 'localhost' to 'host.docker.internal'!)
DATABASE_URL="postgresql://user:password@hostname:5432/dbname?schema=public"

# 2. Security Secrets (Required for Production)
# Replace these with long, randomly generated strings.
JWT_SECRET="your_jwt_access_secret_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_here"

# 3. MinIO Credentials (Optional - Change for Production)
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"


# ==========================================
# ✅ DOCKER DEFAULTS (Usually safe to leave as-is)
# ==========================================
MINIO_ENDPOINT="minio"
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_DEFAULT_BUCKET="webbriks-uploads"
