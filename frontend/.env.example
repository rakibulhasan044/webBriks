# WebBriks Frontend Environment Variables

# The base URL of your NestJS backend API
# When running locally (without Docker), use localhost or 127.0.0.1
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:6001/api/v1

# Optional: If you are running Next.js in a Docker container, 
# you can use this variable to tell Server Components how to reach the backend
# INTERNAL_API_URL=http://backend:6001/api/v1
