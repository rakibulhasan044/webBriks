model Board {
    id          String   @id @default(uuid())
    title       String
    description String?
    coverImage  String?
    ownerId     String
    owner       User     @relation("BoardOwner", fields: [ownerId], references: [id])
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    members BoardMember[]
    columns Column[]

    @@index([ownerId])
    @@map("boards")
}
